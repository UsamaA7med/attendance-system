// ============================================================================
// Prisma Schema for Student Attendance System (Educational Center)
// Database: PostgreSQL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

/// System access roles:
/// - ADMIN: Full control over center configuration, users, classes, and records.
/// - STAFF: Student onboarding, class enrollments, and taking/correcting attendance.
/// - TEACHER: Limited to their assigned classes and taking class attendance.
enum Role {
  ADMIN
  STAFF
  TEACHER
}

/// Status of student attendance for a given lecture.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// Current status of a student's enrollment in a class.
enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

/// User represents administrative, operational, and teaching staff.
/// Authenticated accounts with role-based access control.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  role         Role     @default(TEACHER)
  department   String?  @default("General")
  position     String?  @default("Staff")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  taughtClasses     Class[]        @relation("TeacherClasses")
  createdLectures   Lecture[]      @relation("LectureCreator")
  markedAttendances Attendance[]   @relation("AttendanceMarker")
  refreshTokens     RefreshToken[]

  @@map("users")
}

/// RefreshToken stores issued refresh tokens for session revocation and token rotation.
model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Student represents a registered learner at the educational center.
/// Holds contact info, guardian contact details, and activity state.
model Student {
  id             String   @id @default(cuid())
  fullName       String   @map("full_name")
  phone          String?
  parentName     String   @map("parent_name")
  parentPhone    String   @map("parent_phone")
  notes          String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  enrollmentDate DateTime @default(now()) @map("enrollment_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  enrollments Enrollment[]
  attendances Attendance[]

  @@index([fullName])
  @@index([parentPhone])
  @@map("students")
}

/// Class represents an educational course/group instructed by one teacher.
/// Classes can have multiple scheduled lectures and multiple enrolled students.
model Class {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  room        String?
  isActive    Boolean  @default(true) @map("is_active")
  teacherId   String   @map("teacher_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Restrict)
  lectures    Lecture[]
  enrollments Enrollment[]

  @@index([teacherId])
  @@map("classes")
}

/// Enrollment connects Students to Classes (Many-to-Many junction).
/// Tracks enrollment date and active/dropped status.
model Enrollment {
  id         String           @id @default(cuid())
  studentId  String           @map("student_id")
  classId    String           @map("class_id")
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  status     EnrollmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt      @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@map("enrollments")
}

/// Lecture represents a scheduled or held class lecture on a specific date and start time.
/// Enforces at most one lecture per class at the exact date and start time.
model Lecture {
  id          String   @id @default(cuid())
  classId     String   @map("class_id")
  date        DateTime @db.Date
  startTime   String   @map("start_time") // Format: "HH:mm" (e.g. "14:00")
  notes       String?  @db.Text
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  // Relations
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("LectureCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendances Attendance[]

  @@unique([classId, date, startTime])
  @@index([classId, date])
  @@index([createdById])
  @@map("lectures")
}

/// Attendance stores individual student roll-call records for a specific lecture.
/// Enforces one record per student per lecture, tracking who marked it and when.
model Attendance {
  id         String           @id @default(cuid())
  lectureId  String           @map("lecture_id")
  studentId  String           @map("student_id")
  status     AttendanceStatus @default(PRESENT)
  note       String?          @db.Text
  markedById String?          @map("marked_by_id")
  markedAt   DateTime         @default(now()) @map("marked_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt      @map("updated_at")

  // Relations
  lecture  Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  markedBy User?   @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([lectureId, studentId])
  @@index([studentId])
  @@index([lectureId])
  @@index([markedById])
  @@map("attendances")
}
